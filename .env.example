# ==============================================================================
# Book Worm Environment Configuration Template
# Copy to .env for local Docker Compose deployments
# ==============================================================================

# Database Configuration
DB_NAME=bookworm_db
DB_USERNAME=bookworm_user
DB_PASSWORD=bookworm_secret_pass
DB_PORT=5432

# Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# JWT Security (Must be at least 256 bits / 32 characters in production)
JWT_SECRET=bookworm-production-secure-jwt-signing-secret-key-must-be-256-bits-minimum!
